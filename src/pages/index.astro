---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort();
const locations = [...new Set(jobs.map((job) => job.location))].sort();
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <section class="mb-6" aria-label="Filter open roles">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="department-filter"
                class="block text-sm font-medium text-slate-200 mb-2"
              >
                Department
              </label>
              <select
                id="department-filter"
                data-testid="department-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="">All departments</option>
                {departments.map((department) => (
                  <option value={department}>{department}</option>
                ))}
              </select>
            </div>
            <div>
              <label
                for="location-filter"
                class="block text-sm font-medium text-slate-200 mb-2"
              >
                Location
              </label>
              <select
                id="location-filter"
                data-testid="location-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="">All locations</option>
                {locations.map((location) => (
                  <option value={location}>{location}</option>
                ))}
              </select>
            </div>
          </div>
          <button
            type="button"
            data-testid="role-filter-reset"
            class="mt-4 rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Reset filters
          </button>
        </section>

        <div
          id="roles-grid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          data-testid="roles-grid"
          data-jobs={JSON.stringify(jobs)}
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
        <div
          id="filter-empty-state"
          data-testid="filter-empty-state"
          role="status"
          aria-live="polite"
          hidden
        >
          <EmptyState text="No roles match those filters. Try changing or resetting your filters." />
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';
  import type { Job } from '../types/job';

  const rolesGrid = document.getElementById('roles-grid');
  const departmentFilter = document.querySelector<HTMLSelectElement>(
    '#department-filter',
  );
  const locationFilter = document.querySelector<HTMLSelectElement>(
    '#location-filter',
  );
  const resetButton = document.querySelector<HTMLButtonElement>(
    '[data-testid="role-filter-reset"]',
  );
  const emptyState = document.getElementById('filter-empty-state');

  if (rolesGrid && departmentFilter && locationFilter && resetButton && emptyState) {
    const jobs = JSON.parse(rolesGrid.dataset.jobs ?? '[]') as Job[];
    const cards = Array.from(
      rolesGrid.querySelectorAll<HTMLAnchorElement>('[data-job-id]'),
    );

    /** Update visible role cards and announce when no roles match the filters. */
    const updateResults = (): void => {
      const matchingJobIds = new Set(
        filterJobs(jobs, departmentFilter.value, locationFilter.value).map(
          (job) => job.slug,
        ),
      );

      for (const card of cards) {
        card.hidden = !matchingJobIds.has(card.dataset.jobId ?? '');
      }

      emptyState.hidden = matchingJobIds.size > 0;
    };

    departmentFilter.addEventListener('change', updateResults);
    locationFilter.addEventListener('change', updateResults);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      updateResults();
    });
  }
</script>
